# .env 的说明与模板。通常不用手动创建：./deploy.sh 第一次运行时会自动生成 .env 并填好随机密钥。
# 想手动部署时，把本文件复制为 .env，把 CHANGEME 换成自己的值（可用 openssl rand -hex 16 生成），
# 再执行 docker compose up -d --wait。

# ---------- 访问方式 ----------
# Compose 项目名，决定容器和数据卷的名字前缀；同一台机器部署多套时改成不同的值
COMPOSE_PROJECT_NAME=llm-gateway
# 访问者用来打开页面的地址（IP 或域名），会出现在 Langfuse 的登录跳转和 CREDENTIALS.md 里
PUBLIC_HOST=localhost
# 端口绑定到哪个网卡：127.0.0.1 只允许本机访问，0.0.0.0 允许其他机器访问
BIND_ADDRESS=127.0.0.1
# 对宿主机开放的三个端口，和机器上已有服务冲突时改这里
LITELLM_PORT=4000
LANGFUSE_PORT=3000
MINIO_PORT=9090

# ---------- 基础组件 ----------
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME

# ---------- Langfuse ----------
NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
# 必须是 64 位十六进制（openssl rand -hex 32）
LANGFUSE_ENCRYPTION_KEY=CHANGEME
# 不向 Langfuse 官方上报匿名使用统计
TELEMETRY_ENABLED=false

# 首次启动时自动创建的组织 / 项目 / 管理员账号 / 项目 API Key。
# 仅在数据库里还没有对应记录时生效，之后再改这里不会改动已有账号。
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default
LANGFUSE_INIT_PROJECT_ID=llm-gateway
LANGFUSE_INIT_PROJECT_NAME="LLM Gateway"
# 必须分别以 pk-lf- 和 sk-lf- 开头
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# ---------- LiteLLM ----------
# 管理员密钥：调用网关、登录管理界面（用户名 admin）时使用，必须以 sk- 开头
LITELLM_MASTER_KEY=sk-CHANGEME
# 加密存库的模型凭据，设定后不要再改，必须以 sk- 开头
LITELLM_SALT_KEY=sk-CHANGEME

# ---------- 镜像（可选） ----------
# 默认镜像拉不下来时（比如网络受限），取消注释并换成可访问的镜像地址
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.96.2
# LANGFUSE_IMAGE=langfuse/langfuse:4.55.0
# LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:4.55.0
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest
# REDIS_IMAGE=redis:7.2-alpine
# POSTGRES_IMAGE=postgres:16-alpine
